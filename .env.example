# --- Server ---
PORT=8787
# Comma-separated list of allowed origins for browser-based callers.
# Leave blank to disable CORS (server-to-server only, recommended).
CORS_ORIGINS=

# --- Auth ---
# Comma-separated list of API keys accepted in the `x-api-key` header.
# Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
API_KEYS=change-me-generate-a-real-key

# --- AI provider ---
# Which extraction provider to use: claude | gemini | openai
AI_PROVIDER=claude

# Anthropic Claude (default) - https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Gemini (optional alternate provider) - https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI (optional alternate provider)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Limits ---
MAX_FILE_MB=10
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
